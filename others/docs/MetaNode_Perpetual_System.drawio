        <mxCell id="trade-short" value="做空 (Short)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="125" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="trade-params" value="订单参数:&#xa;• paper: 仓位数量 (正=多/负=空)&#xa;• credit: 资金 (与paper异号)&#xa;• makerFee: 0.01%&#xa;• takerFee: 0.05%" style="text;html=1;strokeColor=none;fillColor=#fff9c4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="335" y="165" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="trade-flow" value="交易流程:&#xa;1. 用户签名订单 (EIP-712)&#xa;2. 后端撮合引擎匹配&#xa;3. 调用 perpetual.trade()&#xa;4. 验证签名 &amp; 保证金&#xa;5. 更新仓位" style="text;html=1;strokeColor=none;fillColor=#e1f5fe;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="335" y="250" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="trade-example" value="示例: 做多1 BTC @ $30,000&#xa;paper=+1e18, credit=-30000e6" style="text;html=1;strokeColor=none;fillColor=#ede7f6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="335" y="340" width="230" height="30" as="geometry" />
        </mxCell>
        
        <!-- 场景3: 清算 -->
        <mxCell id="scenario3-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="80" width="260" height="300" as="geometry" />
        </mxCell>
        <mxCell id="scenario3-title" value="⚠️ 场景3: 清算" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#c62828;" vertex="1" parent="1">
          <mxGeometry x="600" y="90" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="liq-condition" value="清算条件:&#xa;netValue &lt; maintenanceMargin&#xa;&#xa;netValue = 保证金 + 未实现盈亏&#xa;maintenanceMargin = 敞口 × 3%" style="text;html=1;strokeColor=none;fillColor=#fff9c4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="615" y="125" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="liq-params" value="BTC-PERP 风险参数:&#xa;• 初始保证金: 5% (20x杠杆)&#xa;• 维持保证金: 3%&#xa;• 清算折扣: 1%&#xa;• 保险费率: 1%" style="text;html=1;strokeColor=none;fillColor=#e8f5e9;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="615" y="210" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="liq-flow" value="清算流程:&#xa;1. 监控 isSafe() 状态&#xa;2. 清算人调用 liquidate()&#xa;3. 获得 1% 折扣奖励&#xa;4. 保险金收取 1% 费用" style="text;html=1;strokeColor=none;fillColor=#e1f5fe;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="615" y="295" width="230" height="75" as="geometry" />
        </mxCell>
        
        <!-- 场景4: 资金费率 -->
        <mxCell id="scenario4-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="880" y="80" width="260" height="300" as="geometry" />
        </mxCell>
        <mxCell id="scenario4-title" value="💱 场景4: 资金费率" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#2e7d32;" vertex="1" parent="1">
          <mxGeometry x="880" y="90" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="funding-purpose" value="作用: 使永续价格锚定现货" style="text;html=1;strokeColor=none;fillColor=#fff9c4;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="895" y="125" width="230" height="25" as="geometry" />
        </mxCell>
        <mxCell id="funding-positive" value="正费率 (合约价 &gt; 现货价)&#xa;多头付费 → 空头" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="895" y="160" width="230" height="40" as="geometry" />
        </mxCell>
        <mxCell id="funding-negative" value="负费率 (合约价 &lt; 现货价)&#xa;空头付费 → 多头" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="895" y="210" width="230" height="40" as="geometry" />
        </mxCell>
        <mxCell id="funding-formula" value="计算公式:&#xa;credit = paper × fundingRate&#xa;&#xa;Keeper 定期调用:&#xa;updateFundingRate(perps, rates)" style="text;html=1;strokeColor=none;fillColor=#e1f5fe;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="895" y="260" width="230" height="75" as="geometry" />
        </mxCell>
        
        <!-- 底部说明 -->
        <mxCell id="note-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9e9e9e;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="1100" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note-title" value="📋 关键说明" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="405" width="120" height="25" as="geometry" />
        </mxCell>
        <mxCell id="note-content" value="• 永续合约是零和游戏: 多头盈利 = 空头亏损 (忽略手续费)&#xa;• 支持多市场: BTC-PERP (20x), ETH-PERP (10x)&#xa;• EIP-712 签名: 用户链下签名，后端撮合，链上执行" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="430" width="1070" height="45" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  
