          <mxGeometry x="55" y="465" width="150" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="flow1" value="1️⃣ 交易流程" style="text;html=1;strokeColor=none;fillColor=#e3f2fd;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=1;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="55" y="500" width="620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flow1-content" value="用户在前端签名订单(EIP-712) → 发送到后端API → 撮合引擎匹配 → 构建tradeData → 调用Perpetual.trade()&#xa;tradeData = abi.encode(orderList, signatureList, matchPaperAmount)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="520" width="620" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="flow2" value="2️⃣ 存取款流程" style="text;html=1;strokeColor=none;fillColor=#e8f5e9;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=1;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="55" y="570" width="620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flow2-content" value="存款: 前端直接调用 USDC.approve() → MetaNodeDealer.deposit()&#xa;取款: requestWithdraw() → 等待TimeLock → executeWithdraw() (可转到外部或内部账户)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="590" width="620" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="flow3" value="3️⃣ 清算流程" style="text;html=1;strokeColor=none;fillColor=#ffebee;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=1;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="695" y="500" width="620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flow3-content" value="Keeper监控 isSafe(trader) → 发现不安全账户 → 调用 Perpetual.liquidate()&#xa;清算人获得折扣奖励，保险金收取费用，被清算者仓位转移" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="695" y="520" width="620" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="flow4" value="4️⃣ 资金费率" style="text;html=1;strokeColor=none;fillColor=#fff3e0;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=1;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="695" y="570" width="620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flow4-content" value="Keeper定期计算 (markPrice - indexPrice) / indexPrice → 调用 updateFundingRate(perps, rates)&#xa;持仓credit自动更新: credit = paper × fundingRate + reducedCredit" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="695" y="590" width="620" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  
