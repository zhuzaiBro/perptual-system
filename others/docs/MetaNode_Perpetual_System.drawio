        <!-- 底部说明 -->
        <mxCell id="arch-note" value="📋 架构说明: MetaNodeDealer 是核心结算合约，管理用户资金和风险。每个交易对有独立的 Perpetual 合约实例。交易通过 EIP-712 签名验证，由撮合引擎批量提交到链上执行。" style="text;html=1;strokeColor=none;fillColor=#fafafa;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;spacingLeft=10;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="1120" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  
