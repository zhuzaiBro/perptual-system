          <mxGeometry x="40" y="450" width="1120" height="200" as="geometry" />
        </mxCell>
        <mxCell id="pnl-calc-title" value="📊 盈亏计算示例 (假设 BTC 价格从 $30,000 涨到 $35,000)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="455" width="500" height="25" as="geometry" />
        </mxCell>
        
        <!-- Alice 盈亏 -->
        <mxCell id="alice-pnl-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="490" width="530" height="140" as="geometry" />
        </mxCell>
        <mxCell id="alice-pnl-title" value="Alice (多头) - 盈利 🎉" style="text;html=1;strokeColor=none;fillColor=#388e3c;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="55" y="490" width="530" height="25" as="geometry" />
        </mxCell>
        <mxCell id="alice-pnl-calc" value="仓位价值 = paper × markPrice = +1 BTC × $35,000 = +$35,000&#xa;credit (欠款) = -$30,000&#xa;未实现盈亏 = +$35,000 + (-$30,000) = +$5,000 ✅&#xa;&#xa;净值 = primaryCredit + 未实现盈亏 = $9,985 + $5,000 = $14,985" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacingLeft=10;fontFamily=monospace;" vertex="1" parent="1">
          <mxGeometry x="65" y="520" width="510" height="100" as="geometry" />
        </mxCell>
        
        <!-- Bob 盈亏 -->
        <mxCell id="bob-pnl-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="615" y="490" width="530" height="140" as="geometry" />
        </mxCell>
        <mxCell id="bob-pnl-title" value="Bob (空头) - 亏损 😢" style="text;html=1;strokeColor=none;fillColor=#c62828;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="615" y="490" width="530" height="25" as="geometry" />
        </mxCell>
        <mxCell id="bob-pnl-calc" value="仓位价值 = paper × markPrice = -1 BTC × $35,000 = -$35,000&#xa;credit (持有) = +$30,000&#xa;未实现盈亏 = -$35,000 + (+$30,000) = -$5,000 ❌&#xa;&#xa;净值 = primaryCredit + 未实现盈亏 = $9,997 + (-$5,000) = $4,997" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacingLeft=10;fontFamily=monospace;" vertex="1" parent="1">
          <mxGeometry x="625" y="520" width="510" height="100" as="geometry" />
        </mxCell>
        
        <!-- 底部说明 -->
        <mxCell id="ps-note" value="💡 关键设计: 使用 reducedCredit 存储而非直接存 credit，当资金费率更新时，所有持仓者的 credit 自动变化，无需遍历更新每个用户！" style="text;html=1;strokeColor=none;fillColor=#fff9c4;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="665" width="1120" height="35" as="geometry" />
        </mxCell>
