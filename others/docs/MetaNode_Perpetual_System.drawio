          <mxGeometry x="320" y="90" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="trade-long" value="做多 (Long)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="335" y="125" width="100" height="30" as="geometry" />
