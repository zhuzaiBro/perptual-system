        <mxCell id="perp-func" value="• 记录仓位余额&#xa;• 执行交易/清算&#xa;• 更新资金费率" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
