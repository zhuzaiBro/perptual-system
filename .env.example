# Sepolia 部署（配合 script/DeploySepolia.s.sol）
# 复制为 .env 后填写，切勿提交私钥
#
# 编译/部署 MetaNodeDealer 时必须开启（将合约压到 24KB 以内）：
FOUNDRY_PROFILE=sepolia

SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com
# 可选：run_deploy_sepolia.sh 支持用环境变量覆盖 RPC，例如 publicnode TLS 不稳时：
# SEPOLIA_RPC_URL_OVERRIDE=https://sepolia.drpc.org ./script/run_deploy_sepolia.sh

# 必填：部署钱包私钥。多数版本支持 0x 开头 64 位 hex；若报错可去掉 0x 或改用 cast 转为十进制写入。
MetaNode_DEPLOYER_PK=acbed0d94855fb055fe21b8848161fe7bd393042400928d3474d3755e8ed332a

# 可选：不填则默认为部署者地址
# MetaNode_ORDER_SENDER=
# MetaNode_FUNDING_KEEPER=
# MetaNode_INSURANCE=

# 可选：已有 Sepolia USDC/测试代币地址时填写，否则脚本会部署 TestERC20("USDC",6)
# MetaNode_USDC_ADDRESS=

# 合约验证（forge verify 时用）
ETHERSCAN_API_KEY=
